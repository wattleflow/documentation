@startuml FRQ-DRV-16.2-read-sequence
' Putanja čitanja kao INTERAKCIJA — poziv po pozivu.
' Gledište: izvedba. Publika: implementator.
' Prikaz, ne izvor istine (D-13) — izvor je FRQ-DRV-16.2 §5.
' Teza: ovaj tok je ISTI za prijamnik i za transceiver. Uređaj se
' razlikuje samo u vrijednostima iz caps i u parseru koji tvornica vrati.
title FRQ-DRV-16.2 — Read path: identical for every device

autonumber
skinparam SequenceMessageAlignment center

participant "p :\nProcessorSdrCapture" as P
participant "drv :\nDriverSdrDevice" as DRV
participant "con :\nConnectionSdrDevice" as CON
participant "pf :\nParserFactory" as PF
participant "par :\nIqParser" as PAR
participant "bb :\nGenericBlackboard" as BB

activate P
P -> DRV : ensure_live()
activate DRV
DRV -> CON : capabilities()
activate CON
note right of CON
  ispitano pri uspostavi (BR-11),
  NE tablica po modelu uređaja
end note
CON --> DRV : caps {native_format,\nfull_scale, effective_rate, …}
deactivate CON

DRV -> PF : create(caps.native_format)
activate PF
note right of PF
  jedina točka u kojoj razlika
  među uređajima ulazi u kod
end note
PF --> DRV : par
deactivate PF
DRV --> P : live
deactivate DRV

loop dok granica prihvata nije dosegnuta (BR-08)
  P -> DRV : read(uri)
  activate DRV
  DRV -> CON : next_buffer()
  activate CON
  CON --> DRV : bytes, lost_count
  deactivate CON
  DRV -> PAR : deserialise(bytes,\nfull_scale=caps.full_scale)
  activate PAR
  PAR --> DRV : samples
  deactivate PAR
  DRV --> P : SampleBlock(samples, opis, lost_before)
  deactivate DRV

  P -> BB : create(caller=p, content=block)
  activate BB
  BB --> P : facade
  deactivate BB
end

alt gubitak iznad praga (BR-07)
  DRV --> P : kvar — prihvat staje,\nprolaz označen parcijalnim
end

P -> DRV : close()
deactivate P

note over P, BB #E8F5E9
  Zapis: JEDAN sažetak po prolazu, ne redak po bloku (NFRQ-OBS-03).
end note

@enduml
