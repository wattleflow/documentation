@startuml 22_solr-sequence-solr-read
' Generirano iz examples/workflows/22_solr.yaml alatom tools/workflow_diagram.py — ne uređivati ručno.
' Prikaz, ne izvor istine (D-13): izmjena ide u YAML, pa se dijagram regenerira.

skinparam shadowing false
skinparam componentStyle rectangle
skinparam ArrowColor #333333
skinparam component {
    BackgroundColor #FAFAFA
    BorderColor #555555
}
skinparam package {
    BackgroundColor #FFFFFF
    BorderColor #999999
}

title 22_solr.yaml — Apache Solr round-trip — synthetic air-traffic indexing & query
caption solr-read · 22_solr.yaml · okruženje: dev

skinparam sequence {
    LifeLineBorderColor #999999
    ParticipantBorderColor #555555
    ParticipantBackgroundColor #FAFAFA
}

participant "solr-air-traffic" as WF
group solr-read <<SolrReadProcessor>>
  participant "solr-read" as PR2
  participant "solr-read-blackboard" as BB2
  participant "solr-read-pipeline" as P2_1
  WF -> PR2 : start()
  PR2 -> PR2 : iterate source
  PR2 -> BB2 : create() «CreateSolrDocument»
  PR2 -> P2_1 : transform()  <<SolrReadPipeline>>
  P2_1 -> BB2 : write()
  note over BB2 : bez repozitorija — dokument ostaje na blackboardu
end
@enduml
