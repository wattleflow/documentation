@startuml 05_tika-sequence-processor-tika
' Generirano iz examples/workflows/05_tika.yaml alatom tools/workflow_diagram.py — ne uređivati ručno.
' Prikaz, ne izvor istine (D-13): izmjena ide u YAML, pa se dijagram regenerira.

skinparam shadowing false
skinparam componentStyle rectangle
skinparam ArrowColor #333333
skinparam component {
    BackgroundColor #FAFAFA
    BorderColor #555555
}
skinparam package {
    BackgroundColor #FFFFFF
    BorderColor #999999
}

title 01_processor_synthetic_data.yaml — Processor - Synthetic data - ETL - Wattleflow Workflow
caption processor-tika · 05_tika.yaml · okruženje: dev

skinparam sequence {
    LifeLineBorderColor #999999
    ParticipantBorderColor #555555
    ParticipantBackgroundColor #FAFAFA
}

participant "tika-procesor-workflow" as WF
group processor-tika <<OCRTextProcessor>>
  participant "processor-tika" as PR1
  participant "tika-blackboard" as BB1
  participant "cleanup-pipeline" as P1_1
  participant "local-storage-repository" as R1_1
  WF -> PR1 : start()
  PR1 -> PR1 : iterate source
  PR1 -> BB1 : create() «CreateTextDocument»
  PR1 -> P1_1 : transform()  <<CleanupTextDocumentPipeline>>
  P1_1 -> BB1 : write()
  BB1 -> R1_1 : «WriteTextDocumentToFile»
end
@enduml
