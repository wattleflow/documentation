@startuml 21_orc-sequence-orc-read
' Generirano iz examples/workflows/21_orc.yaml alatom tools/workflow_diagram.py — ne uređivati ručno.
' Prikaz, ne izvor istine (D-13): izmjena ide u YAML, pa se dijagram regenerira.

skinparam shadowing false
skinparam componentStyle rectangle
skinparam ArrowColor #333333
skinparam component {
    BackgroundColor #FAFAFA
    BorderColor #555555
}
skinparam package {
    BackgroundColor #FFFFFF
    BorderColor #999999
}

title 21_orc.yaml — Apache ORC round-trip — synthetic air-traffic data
caption orc-read · 21_orc.yaml · okruženje: dev

skinparam sequence {
    LifeLineBorderColor #999999
    ParticipantBorderColor #555555
    ParticipantBackgroundColor #FAFAFA
}

participant "orc-air-traffic" as WF
group orc-read <<OrcReadProcessor>>
  participant "orc-read" as PR2
  participant "orc-read-blackboard" as BB2
  participant "orc-read-pipeline" as P2_1
  WF -> PR2 : start()
  PR2 -> PR2 : iterate source
  PR2 -> BB2 : create() «CreateOrcDocument»
  PR2 -> P2_1 : transform()  <<OrcReadPipeline>>
  P2_1 -> BB2 : write()
  note over BB2 : bez repozitorija — dokument ostaje na blackboardu
end
@enduml
