@startuml 02_excel_seifa-sequence-excel-workbook-processor
' Generirano iz examples/workflows/02_excel_seifa.yaml alatom tools/workflow_diagram.py — ne uređivati ručno.
' Prikaz, ne izvor istine (D-13): izmjena ide u YAML, pa se dijagram regenerira.

skinparam shadowing false
skinparam componentStyle rectangle
skinparam ArrowColor #333333
skinparam component {
    BackgroundColor #FAFAFA
    BorderColor #555555
}
skinparam package {
    BackgroundColor #FFFFFF
    BorderColor #999999
}

title 02_excel_seifa.yaml — Wattleflow Workflow - Excel example (SEIFA)
caption excel-workbook-processor · 02_excel_seifa.yaml · okruženje: dev

skinparam sequence {
    LifeLineBorderColor #999999
    ParticipantBorderColor #555555
    ParticipantBackgroundColor #FAFAFA
}

participant "excel-files-processing" as WF
group excel-workbook-processor <<ExcelWorkbookProcessor>>
  participant "excel-workbook-processor" as PR1
  participant "excel-data-blackboard" as BB1
  participant "excel-data-cleanup" as P1_1
  participant "local-storage-repository" as R1_1
  WF -> PR1 : start()
  PR1 -> PR1 : iterate source
  PR1 -> BB1 : create() «CreateDataframeFromExcel»
  PR1 -> P1_1 : transform()  <<ExcelCleanupPipeline>>
  P1_1 -> BB1 : write()
  BB1 -> R1_1 : «WriteExcelDataFrame»
end
@enduml
