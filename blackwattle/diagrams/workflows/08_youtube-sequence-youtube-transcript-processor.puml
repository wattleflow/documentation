@startuml 08_youtube-sequence-youtube-transcript-processor
' Generirano iz examples/workflows/08_youtube.yaml alatom tools/workflow_diagram.py — ne uređivati ručno.
' Prikaz, ne izvor istine (D-13): izmjena ide u YAML, pa se dijagram regenerira.

skinparam shadowing false
skinparam componentStyle rectangle
skinparam ArrowColor #333333
skinparam component {
    BackgroundColor #FAFAFA
    BorderColor #555555
}
skinparam package {
    BackgroundColor #FFFFFF
    BorderColor #999999
}

title 08_youtube.yaml — Youtube video transcript ETL processor - Wattleflow Workflow
caption youtube-transcript-processor · 08_youtube.yaml · okruženje: dev

skinparam sequence {
    LifeLineBorderColor #999999
    ParticipantBorderColor #555555
    ParticipantBackgroundColor #FAFAFA
}

participant "youtube-workflow" as WF
group youtube-transcript-processor <<YoutubeProcessor>>
  participant "youtube-transcript-processor" as PR1
  participant "youtube-blackboard" as BB1
  participant "youtube-pipeline" as P1_1
  participant "local-storage-repository" as R1_1
  WF -> PR1 : start()
  PR1 -> PR1 : iterate source
  PR1 -> BB1 : create() «BlackboarCreateYoutubeRDF»
  PR1 -> P1_1 : transform()  <<CleanupPipelineYoutube>>
  P1_1 -> BB1 : write()
  BB1 -> R1_1 : «RepositoryWriteYoutubeRDF»
end
@enduml
