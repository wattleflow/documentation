@startuml 13_translate_hr-sequence-processor-translate-en-hr
' Generirano iz examples/workflows/13_translate_hr.yaml alatom tools/workflow_diagram.py — ne uređivati ručno.
' Prikaz, ne izvor istine (D-13): izmjena ide u YAML, pa se dijagram regenerira.

skinparam shadowing false
skinparam componentStyle rectangle
skinparam ArrowColor #333333
skinparam component {
    BackgroundColor #FAFAFA
    BorderColor #555555
}
skinparam package {
    BackgroundColor #FFFFFF
    BorderColor #999999
}

title 13_translate_hr.yaml — Wattleflow Workflow - EN -> HR translation (local HuggingFace model)
caption processor-translate-en-hr · 13_translate_hr.yaml · okruženje: dev

skinparam sequence {
    LifeLineBorderColor #999999
    ParticipantBorderColor #555555
    ParticipantBackgroundColor #FAFAFA
}

participant "workflow" as WF
group processor-translate-en-hr <<TranslateProcessor>>
  participant "processor-translate-en-hr" as PR1
  participant "translate-blackboard" as BB1
  participant "pipeline-pdf-extract" as P1_1
  participant "pipeline-translate-en-hr" as P1_2
  participant "repository-hr-txt" as R1_1
  WF -> PR1 : start()
  PR1 -> PR1 : iterate source
  PR1 -> BB1 : create() «CreateTranslationDocument»
  PR1 -> P1_1 : transform()  <<PipelineExtractText>>
  P1_1 -> BB1 : write()
  BB1 -> R1_1 : «WriteTranslationToFile»
  PR1 -> P1_2 : transform()  <<PipelineTranslateEnHr>>
  P1_2 -> BB1 : write()
  BB1 -> R1_1 : «WriteTranslationToFile»
end
@enduml
