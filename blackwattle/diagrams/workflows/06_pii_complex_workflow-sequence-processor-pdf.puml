@startuml 06_pii_complex_workflow-sequence-processor-pdf
' Generirano iz examples/workflows/06_pii_complex_workflow.yaml alatom tools/workflow_diagram.py — ne uređivati ručno.
' Prikaz, ne izvor istine (D-13): izmjena ide u YAML, pa se dijagram regenerira.

skinparam shadowing false
skinparam componentStyle rectangle
skinparam ArrowColor #333333
skinparam component {
    BackgroundColor #FAFAFA
    BorderColor #555555
}
skinparam package {
    BackgroundColor #FFFFFF
    BorderColor #999999
}

title 03_pii_complex_workflow.yaml — Wattleflow Workflow - per-type processors routing many labels by filename format (pdf/eml/msg).
caption processor-pdf · 06_pii_complex_workflow.yaml · okruženje: dev

skinparam sequence {
    LifeLineBorderColor #999999
    ParticipantBorderColor #555555
    ParticipantBackgroundColor #FAFAFA
}

participant "workflow" as WF
group processor-pdf <<EntityFileDocumentProcessor>>
  participant "processor-pdf" as PR1
  participant "bb-pdf" as BB1
  participant "entities" as P1_1
  participant "pdf-redaction" as P1_2
  participant "repo-reduced-pdf" as R1_1
  participant "repo-evidence-pdf" as R1_2
  WF -> PR1 : start()
  PR1 -> PR1 : iterate source
  PR1 -> BB1 : create() «CreatePdfDocument»
  PR1 -> P1_1 : transform()  <<PipelineProcessorDriverEntities>>
  P1_1 -> BB1 : write()
  PR1 -> P1_2 : transform()  <<PipelinePDFRedact>>
  P1_2 -> BB1 : write()
  group flush (defer_flush: true)
    PR1 -> BB1 : flush()
    BB1 -> R1_1 : «WriteRoutedText»
    BB1 -> R1_2 : «WriteRoutedEvidence»
  end
end
@enduml
