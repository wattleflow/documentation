@startuml 24_elasticsearch-sequence-elasticsearch-read
' Generirano iz examples/workflows/24_elasticsearch.yaml alatom tools/workflow_diagram.py — ne uređivati ručno.
' Prikaz, ne izvor istine (D-13): izmjena ide u YAML, pa se dijagram regenerira.

skinparam shadowing false
skinparam componentStyle rectangle
skinparam ArrowColor #333333
skinparam component {
    BackgroundColor #FAFAFA
    BorderColor #555555
}
skinparam package {
    BackgroundColor #FFFFFF
    BorderColor #999999
}

title 24_elasticsearch.yaml — Elasticsearch synthetic write + DSL search round-trip
caption elasticsearch-read · 24_elasticsearch.yaml · okruženje: dev

skinparam sequence {
    LifeLineBorderColor #999999
    ParticipantBorderColor #555555
    ParticipantBackgroundColor #FAFAFA
}

participant "elasticsearch-air-traffic" as WF
group elasticsearch-read <<ElasticSearchReadProcessor>>
  participant "elasticsearch-read" as PR2
  participant "es-read-blackboard" as BB2
  participant "es-read-pipeline" as P2_1
  WF -> PR2 : start()
  PR2 -> PR2 : iterate source
  PR2 -> BB2 : create() «CreateElasticSearchDocument»
  PR2 -> P2_1 : transform()  <<ElasticSearchReadPipeline>>
  P2_1 -> BB2 : write()
  note over BB2 : bez repozitorija — dokument ostaje na blackboardu
end
@enduml
