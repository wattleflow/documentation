@startuml 03_pdf_pii-sequence-file-processor
' Generirano iz examples/workflows/03_pdf_pii.yaml alatom tools/workflow_diagram.py — ne uređivati ručno.
' Prikaz, ne izvor istine (D-13): izmjena ide u YAML, pa se dijagram regenerira.

skinparam shadowing false
skinparam componentStyle rectangle
skinparam ArrowColor #333333
skinparam component {
    BackgroundColor #FAFAFA
    BorderColor #555555
}
skinparam package {
    BackgroundColor #FFFFFF
    BorderColor #999999
}

title 04_pdf_pii.yaml — Wattleflow Workflow - PII reduction workflow for PDF and PNG files.
caption file-processor · 03_pdf_pii.yaml · okruženje: dev

skinparam sequence {
    LifeLineBorderColor #999999
    ParticipantBorderColor #555555
    ParticipantBackgroundColor #FAFAFA
}

participant "workflow" as WF
group file-processor <<EntityFileDocumentProcessor>>
  participant "file-processor" as PR1
  participant "blackboard-pdf" as BB1
  participant "entities" as P1_1
  participant "pdf-transformation-pipline" as P1_2
  participant "repository-text-reduced" as R1_1
  WF -> PR1 : start()
  PR1 -> PR1 : iterate source
  PR1 -> BB1 : create() «CreatePdfDocument»
  PR1 -> P1_1 : transform()  <<PipelineProcessorDriverEntities>>
  P1_1 -> BB1 : write()
  PR1 -> P1_2 : transform()  <<PipelinePDFRedact>>
  P1_2 -> BB1 : write()
  group flush (defer_flush: true)
    PR1 -> BB1 : flush()
    BB1 -> R1_1 : «WriteTextContent»
  end
end
@enduml
