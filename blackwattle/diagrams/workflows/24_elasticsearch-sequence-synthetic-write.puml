@startuml 24_elasticsearch-sequence-synthetic-write
' Generirano iz examples/workflows/24_elasticsearch.yaml alatom tools/workflow_diagram.py — ne uređivati ručno.
' Prikaz, ne izvor istine (D-13): izmjena ide u YAML, pa se dijagram regenerira.

skinparam shadowing false
skinparam componentStyle rectangle
skinparam ArrowColor #333333
skinparam component {
    BackgroundColor #FAFAFA
    BorderColor #555555
}
skinparam package {
    BackgroundColor #FFFFFF
    BorderColor #999999
}

title 24_elasticsearch.yaml — Elasticsearch synthetic write + DSL search round-trip
caption synthetic-write · 24_elasticsearch.yaml · okruženje: dev

skinparam sequence {
    LifeLineBorderColor #999999
    ParticipantBorderColor #555555
    ParticipantBackgroundColor #FAFAFA
}

participant "elasticsearch-air-traffic" as WF
group synthetic-write <<ElasticSearchSyntheticWriteProcessor>>
  participant "synthetic-write" as PR1
  participant "es-write-blackboard" as BB1
  participant "es-write-pipeline" as P1_1
  participant "elasticsearch-repository" as R1_1
  WF -> PR1 : start()
  PR1 -> PR1 : iterate source
  PR1 -> BB1 : create() «CreateElasticSearchDocument»
  PR1 -> P1_1 : transform()  <<ElasticSearchWritePipeline>>
  P1_1 -> BB1 : write()
  BB1 -> R1_1 : «WriteElasticSearchDocument»
end
@enduml
