' Palette roles as preprocessor variables (hex without '#', usable in inline styles: #line:$WF_PRIMARY;line.bold;text:$WF_TEXT)
!$WF_BACKGROUND = "2d5a54"
!$WF_PRIMARY = "e8b924"
!$WF_SECONDARY = "6ba89e"
!$WF_ERROR = "c74c3c"
!$WF_TEXT = "ffffff"

' C4: applies only when a C4 library was included before this file
!if %function_exists("UpdateElementStyle")
skinparam titleFontColor #ffffff
skinparam legendBackgroundColor #2d5a54
skinparam legendFontColor #ffffff
skinparam legendBorderColor #e8b924
UpdateElementStyle("system", $bgColor="#2d5a54", $fontColor="#ffffff", $borderColor="#e8b924")
UpdateElementStyle("external_system", $bgColor="#6ba89e", $fontColor="#ffffff", $borderColor="#e8b924")
UpdateElementStyle("person", $bgColor="#6ba89e", $fontColor="#ffffff", $borderColor="#e8b924")
UpdateBoundaryStyle($fontColor="#ffffff", $borderColor="#6ba89e")
UpdateRelStyle($textColor="#ffffff", $lineColor="#e8b924")
!endif
